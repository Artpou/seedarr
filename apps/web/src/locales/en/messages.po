ct-2/3 w-full overflow-hidden rounded-md border border-secondary shadow-2xl" onMouseEnter={preloadMoviPlayer} onPointerDown={preloadMoviPlayer} > {posterImage} <div className="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/25"> <span className="flex size-16 items-center justify-center rounded-full bg-primary/85 shadow-lg"> <PlayIcon className="ml-1 size-8 fill-current text-white" aria-hidden /> </span> </div> {qualityBadge} </div> </TvFocusable> {showWatchProgress && ( <div className="flex w-full flex-col gap-1.5"> <Progress value={watchProgressPercent} max={100} className="h-1.5 w-full" /> {remainingMinutes != null && ( <p className="text-center text-sm text-muted-foreground"> <Trans> {plural(remainingMinutes, { one: "# minute remaining", other: "# minutes remaining", })} </Trans> </p> )} </div> )} </> ) : ( <> <div className="relative aspect-2/3 w-full"> <div className={cn( "group/poster relative w-full overflow-hidden rounded-md border border-secondary shadow-2xl", showWatchProgress && !tvMode ? "h-[calc(100%-0.75rem)]" : "h-full", )} > {posterImage} {canPlay && ( <MediaButtonPlay className="absolute inset-0 flex items-center justify-center bg-black/0 transition-colors group-hover/poster:bg-black/50" media={media} downloadId={download?.id} circular /> )} {qualityBadge} </div> </div> {showWatchProgress && !tvMode && ( <Progress value={watchProgressPercent} max={100} className="h-1 w-full" /> )} </> )} <div className="flex w-full flex-col gap-2"> {canPlay && !tvMode && ( <MediaButtonPlay media={media} downloadId={download?.id} className="w-full" /> )} {!download && role !== "viewer" && <MediaButtonTorrent media={media} className="w-full" size="lg" />} {!download && role === "viewer" && <MediaButtonRequest media={media} className="w-full" size="lg" />} {!download && ( <MediaButtonTrailer title={displayTitle} data={data} variant="secondary" className="w-full" size="lg" /> )} {canDownload && videoFile && !tvMode && ( <MediaDownloadButto